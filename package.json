{
    "name": "mineai",
    "type": "module",
    "dependencies": {
        "@anthropic-ai/sdk": "^0.17.1",
        "@cerebras/cerebras_cloud_sdk": "^1.46.0",
        "@google/genai": "^1.15.0",
        "@huggingface/inference": "^2.8.1",
        "@mistralai/mistralai": "^1.1.0",
        "@xmcl/mod-parser": "^3.4.2",
        "canvas": "^3.1.0",
        "cheerio": "^1.0.0",
        "express": "^4.18.2",
        "google-translate-api-x": "^10.7.1",
        "groq-sdk": "^0.15.0",
        "minecraft-data": "^3.97.0",
        "mineflayer": "^4.33.0",
        "mineflayer-armor-manager": "^2.0.1",
        "mineflayer-auto-eat": "^3.3.6",
        "mineflayer-collectblock": "^1.4.1",
        "mineflayer-pathfinder": "^2.4.5",
        "mineflayer-pvp": "^1.3.2",
        "node-canvas-webgl": "^0.3.0",
        "open": "^10.2.0",
        "openai": "^4.4.0",
        "prismarine-item": "^1.15.0",
        "prismarine-viewer": "^1.32.0",
        "replicate": "^0.29.4",
        "ses": "^1.9.1",
        "socket.io": "^4.7.2",
        "socket.io-client": "^4.7.2",
        "three": "^0.128.0",
        "vec3": "^0.1.10",
        "yargs": "^17.7.2"
    },
    "overrides": {
        "canvas": "^3.1.0",
        "gl": "^8.1.6"
    },
    "scripts": {
        "postinstall": "patch-package",
        "start": "tsx main.ts",
        "dev": "tsx main.ts",
        "test": "node --import tsx --test tests/**/*.test.ts",
        "typecheck": "tsc --noEmit",
        "voice:send": "tsx scripts/send-voice.ts",
        "voice:test:openvoice": "tsx scripts/test-openvoice-local.ts",
        "voice:test:doubao": "tsx scripts/test-doubao-voice.ts",
        "voice:test:doubao-asr": "tsx scripts/test-doubao-asr.ts",
        "voice:mic": "tsx scripts/run-voice-mic.ts",
        "voice:clone:doubao": "tsx scripts/doubao-clone.ts",
        "voice:profiles": "tsx scripts/voice-profiles.ts",
        "client:bridge": "tsx scripts/run-client-bridge.ts",
        "client:command": "tsx scripts/send-client-command.ts",
        "client:list": "tsx scripts/list-client-bridge.ts",
        "client:autocombat": "tsx scripts/run-client-autocombat.ts",
        "forge-agent:build": "powershell -ExecutionPolicy Bypass -File scripts/build-forge-agent.ps1",
        "forge-agent:deploy": "tsx scripts/deploy-forge-agent.ts",
        "reinstall": "npm run clean:modules && npm install",
        "clean:modules": "node -e \"const fs=require('fs');const p=require('path');['node_modules','package-lock.json'].forEach(f=>{if(fs.existsSync(f)){if(fs.lstatSync(f).isDirectory()){fs.rmSync(f,{recursive:true,force:true});}else{fs.unlinkSync(f);}}});\""
    },
    "devDependencies": {
        "@eslint/js": "^9.13.0",
        "@types/node": "^24.5.2",
        "@types/yargs": "^17.0.33",
        "eslint": "^9.13.0",
        "eslint-plugin-no-floating-promise": "^2.0.0",
        "globals": "^15.11.0",
        "patch-package": "^8.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.2"
    }
}
