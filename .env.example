# Copy this file to .env. Never commit the real .env file.

# LLM used by profiles/chinese_npc.json
DEEPSEEK_API_KEY=

# Doubao new-console API key for duplex realtime speech and HTTP v3 TTS.
DOUBAO_API_KEY=

# Optional model override for the explicit HTTP v3 TTS adapter.
DOUBAO_TTS_MODEL=seed-audio-1.0
